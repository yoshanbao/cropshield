// Prisma schema for CropShield
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  WORKER
  FARMER
  EXPERT
  ADMIN
}

enum CaseStatus {
  PENDING
  VERIFIED
  CORRECTED
}

enum ReviewAction {
  VERIFIED
  CORRECTED
}

enum ReviewDecision {
  REVIEWED
  NEEDS_REVISION
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(FARMER)
  active       Boolean @default(true)
  isDemo       Boolean @default(false)
  farmCases    FarmCase[] @relation("FarmCreator")
  farmObservations FarmObservation[] @relation("FarmObserver")
  farmImages   FarmImage[] @relation("FarmUploader")
  farmAssignments FarmAssignment[] @relation("FarmWorker")
  farmDraft    FarmDraft?
  farmScreenings FarmScreening[]
  cases           Case[]
  reviews         CaseReview[]
  diseaseReviews  DiseaseReview[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ImageSuitability {
  SCREENABLE
  SUGGESTIVE_ONLY
  FIELD_OR_LAB_ONLY
}

model Disease {
  id         String   @id @default(cuid())
  cropType   String
  name       String
  symptoms   String   @db.Text
  management String   @db.Text
  prevention String   @db.Text
  // Plain-language description of the harm the disease causes (nullable; additive).
  damage     String?  @db.Text
  // How suitable this disease is for photo screening. Nullable with NO default:
  // unset records must NOT be treated as confident image matches.
  imageSuitability ImageSuitability?
  // Structured source attribution (nullable; farmer-facing text has no citations).
  sourceTitle      String?
  sourceOrg        String?
  sourceUrl        String?
  sourceReviewedAt DateTime?
  // Every knowledge entry requires local agricultural-expert review before use.
  needsExpertReview Boolean @default(true)
  diseaseReviews    DiseaseReview[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([cropType, name])
}

// Append-only audit trail of expert reviews of disease knowledge-base records.
// A disease may accumulate many reviews over time. Existing Disease fields
// (symptoms/management/prevention/sources) are never overwritten here.
model DiseaseReview {
  id         String         @id @default(cuid())
  diseaseId  String
  disease    Disease        @relation(fields: [diseaseId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User           @relation(fields: [reviewerId], references: [id])
  decision   ReviewDecision
  note       String?        @db.Text
  createdAt  DateTime       @default(now())

  @@index([diseaseId, createdAt])
  @@index([reviewerId, createdAt])
}

model Case {
  id          String     @id @default(cuid())
  farmerId    String
  farmer      User       @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  cropType    String
  // Generated filename of the uploaded image, stored on disk under uploads/
  // (outside public/) and served only via the authorized image route.
  imagePath   String
  aiResult    Json
  confidence  Float
  status      CaseStatus @default(PENDING)
  // Legacy single-note field kept for backward compatibility. The authoritative
  // record of expert actions is the append-only CaseReview history below.
  expertNotes String?    @db.Text
  reviews     CaseReview[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([farmerId])
}

// Append-only audit trail of expert review actions on a case. A case may have
// many reviews over time. The original Case.aiResult is never modified.
model CaseReview {
  id                 String       @id @default(cuid())
  caseId             String
  case               Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewerId         String
  reviewer           User         @relation(fields: [reviewerId], references: [id])
  action             ReviewAction
  previousStatus     CaseStatus
  // The corrected condition name, when the action is a CORRECTED diagnosis.
  correctedCondition String?
  // Notes the farmer is allowed to see.
  farmerVisibleNote  String?      @db.Text
  // Notes visible only to experts/admins, never shown to the farmer.
  internalNote       String?      @db.Text
  createdAt          DateTime     @default(now())

  @@index([caseId, createdAt])
  @@index([reviewerId, createdAt])
}

// Current screening and monitoring workflow. Legacy tables remain intact.
enum FarmCaseStatus {
  OPEN
  MONITORING
  CLOSED
}

model CropCondition {
  id           String @id
  crop         String
  kind         String @default("Disease")
  name         String
  cues         String @db.Text
  care         String @db.Text
  prevention   String @db.Text
  source       String
  sourceUrl    String @db.Text
  version      String
  reviewStatus String
  reviewedAt   DateTime? @db.Date
  enabled      Boolean @default(false)
  limitations  String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([crop, enabled])
}

model FarmCase {
  id            String @id
  crop          String
  area          String
  sampleLabel   String
  plantAge      String?
  createdById   String
  creator       User @relation("FarmCreator", fields: [createdById], references: [id])
  status        FarmCaseStatus @default(OPEN)
  nextFollowUp  DateTime? @db.Date
  screening     Json
  sample        Boolean @default(false)
  walkthrough   Boolean @default(false)
  submissionHash String?
  revision      Int @default(0)
  observations  FarmObservation[]
  assignments   FarmAssignment[]
  statusEvents  FarmStatusEvent[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([createdById, status])
  @@index([crop, status])
}

model FarmObservation {
  id          String @id
  caseId      String
  cropCase    FarmCase @relation(fields: [caseId], references: [id])
  date        DateTime @db.Date
  symptoms    String @db.Text
  actions     String @db.Text
  change      String
  authorId    String
  author      User @relation("FarmObserver", fields: [authorId], references: [id])
  photoId     String?
  photo       FarmImage? @relation(fields: [photoId], references: [id])
  samplePath  String?
  createdAt   DateTime @default(now())
  @@index([caseId, date])
}

model FarmImage {
  id           String @id
  uploaderId   String
  uploader     User @relation("FarmUploader", fields: [uploaderId], references: [id])
  mimeType     String
  bytes        Bytes @db.MediumBlob
  observations FarmObservation[]
  createdAt    DateTime @default(now())
  @@index([uploaderId])
}

model FarmAssignment {
  caseId String
  userId String
  cropCase FarmCase @relation(fields: [caseId], references: [id])
  user User @relation("FarmWorker", fields: [userId], references: [id])
  @@id([caseId, userId])
}

model FarmStatusEvent {
  id        String @id @default(cuid())
  caseId    String
  cropCase  FarmCase @relation(fields: [caseId], references: [id])
  status    String
  reason    String @db.Text
  createdAt DateTime @default(now())
  @@index([caseId, createdAt])
}

model FarmDraft {
  userId    String @id
  user      User @relation(fields: [userId], references: [id])
  data      Json
  updatedAt DateTime @updatedAt
}

model FarmScreening {
  id          String @id
  userId      String
  user        User @relation(fields: [userId], references: [id])
  fingerprint String
  mode        String @default("live")
  scenario    String?
  claimToken  String?
  state       String @default("PENDING")
  result      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId])
}
