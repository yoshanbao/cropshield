APP_NAME=CropShield
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8001
APP_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cropshield_laravel
DB_USERNAME=your_mysql_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=cropshield_laravel_session
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=error
BCRYPT_ROUNDS=12

# Server-side only. Leave blank when using the labeled sample workflow.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Demo users require APP_ENV=local/testing AND a loopback host.
CROPSHIELD_LOCAL_DEMO=true

# Optional: private connection to the previous Next.js database for one-time import.
LEGACY_DATABASE_URL=
